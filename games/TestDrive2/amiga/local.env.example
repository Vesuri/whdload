# Copy to amiga/local.env (ignored) and set this machine's paths. NAME=value lines only:
# shell, make and tools/local_env.py all read it. Values may use ${HOME} and earlier
# ${NAME}s. Variables already set in the environment win.

# kick31.rom (host), kick34005.A500 (slave), kick40068.A1200 (A1200 host)
KICKSTART_DIR=/path/to/kickstarts
# Kickstart 1.3 relocation table for WHDLoad's KickEmu (aminet util/boot/skick346.lha)
RTB=/path/to/kick34005.A500.RTB
# Workbench 2.04 floppy: the host boot disk (gives C: and Libs:)
WB=/path/to/Workbench2.04.adf
# WHDLoad executable the emulated Amiga runs (17.2 or later)
WHDLOAD_BINARY=/path/to/WHDLoad/C/WHDLoad
# Helper that claims a debugger port and kills only this checkout's emulator
FSUAE_COMMON=/path/to/fsuae_common.sh
# m68k-amiga-elf toolchain prefix: bin/m68k-amiga-elf-{gdb,objdump}, m68k-amiga-elf/sys-include
AMIGA_TOOLCHAIN=/path/to/m68k-amiga-elf
# vasm, Motorola syntax
VASM=/path/to/vasmm68k_mot
# LHa for UNIX (writes LH5 archives; Lhasa cannot create them)
LHA=/path/to/lha
# Extra PATH directories, e.g. the FS-UAE build with the Barto gdb stub
AMIGA_PATH=/path/to/fs-uae
