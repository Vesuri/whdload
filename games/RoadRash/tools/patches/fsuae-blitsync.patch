+/* Blitter-sync observer (Road Rash harness diagnostic). A blit is open from its BLTSIZE
+   write until the CPU reads DMACONR with BBUSY clear, as a blitter wait does. CPU access
+   to an open blit's D rows, a CPU write to its A/B/C rows (when the minterm uses them) and
+   a CPU write to a blitter register (REG) are logged once per PC and blit, whether or not
+   the emulated blit is still running ("live" says which). BLITSYNC_LOG=FILE enables it. */
+static FILE *blitsync_f; static int blitsync_init_done, blitsync_lines;
+static int blitsync_open; static uaecptr blitsync_pc; static uae_u16 blitsync_con0, blitsync_size_v, blitsync_size_h;
+static uae_u32 blitsync_lo[4], blitsync_hi[4], blitsync_first[4]; static long blitsync_stride[4]; static int blitsync_rowbytes, blitsync_desc;
+static uae_u32 blitsync_seen[4096];
+static void blitsync_range(int ch, uae_u32 p, int mod, int desc)
+{
+	int rowbytes = blt_info.hblitsize * 2, v = blt_info.vblitsize;
+	long stride = rowbytes + mod;
+	long first = (long)p, last;
+	blitsync_first[ch] = p; blitsync_stride[ch] = stride; blitsync_rowbytes = rowbytes; blitsync_desc = desc;
+	if (!desc) {
+		last = first + (long)(v - 1) * stride;
+		blitsync_lo[ch] = (uae_u32)(first < last ? first : last);
+		blitsync_hi[ch] = (uae_u32)((first > last ? first : last) + rowbytes);
+	} else {
+		last = first - (long)(v - 1) * stride;
+		blitsync_lo[ch] = (uae_u32)((first < last ? first : last) - rowbytes + 2);
+		blitsync_hi[ch] = (uae_u32)((first > last ? first : last) + 2);
+	}
+}
+static void blitsync_start(uaecptr pc)
+{
+	if (!blitsync_init_done) {
+		const char *p = getenv("BLITSYNC_LOG");
+		blitsync_init_done = 1;
+		if (p && *p) blitsync_f = fopen(p, "w");
+	}
+	if (!blitsync_f) return;
+	blitsync_open = 0;
+	if (bltcon1 & 1) return; /* line mode: not tracked */
+	int desc = (bltcon1 & 2) != 0;
+	for (int i = 0; i < 4; i++) blitsync_lo[i] = blitsync_hi[i] = 0;
+	if (bltcon0 & 0x800) blitsync_range(0, bltapt, blt_info.bltamod, desc);
+	if (bltcon0 & 0x400) blitsync_range(1, bltbpt, blt_info.bltbmod, desc);
+	if (bltcon0 & 0x200) blitsync_range(2, bltcpt, blt_info.bltcmod, desc);
+	if (bltcon0 & 0x100) blitsync_range(3, bltdpt, blt_info.bltdmod, desc);
+	blitsync_open = 1; blitsync_pc = pc; blitsync_con0 = bltcon0;
+	blitsync_size_v = blt_info.vblitsize; blitsync_size_h = blt_info.hblitsize;
+}
+void blitsync_close(uae_u16 dmaconr)
+{
+	if (blitsync_open && !(dmaconr & 0x4000)) blitsync_open = 0;
+}
+void blitsync_reg(int reg, int live)
+{
+	if (!blitsync_open || !blitsync_f) return;
+	uaecptr pc = M68K_GETPC;
+	uae_u32 key = pc * 31u + blitsync_pc * 7u + 0x9000u + reg;
+	uae_u32 h = (key ^ (key >> 13)) & 4095;
+	if (blitsync_seen[h] == key + 1) return;
+	blitsync_seen[h] = key + 1;
+	if (blitsync_lines++ < 20000) {
+		fprintf(blitsync_f, "frame=%d vpos=%d pc=%08x REG addr=dff%03x ch=R blitpc=%08x con0=%04x size=%dx%d range=000000-000000 live=%d irq=%d\n",
+			vsync_counter, vpos, pc, reg, blitsync_pc, blitsync_con0, blitsync_size_h, blitsync_size_v, live, regs.intmask);
+		fflush(blitsync_f);
+	}
+}
+void blitsync_cpu(uaecptr addr, int size, int write)
+{
+	if (!blitsync_open || !blitsync_f) return;
+	addr &= chipmem_bank.mask;
+	for (int ch = 0; ch < 4; ch++) {
+		if (blitsync_lo[ch] == blitsync_hi[ch]) continue;
+		if (ch < 3 && !write) continue;
+		if (ch < 3 && ((blitsync_con0 & 0xff) == 0 || (blitsync_con0 & 0xff) == 0xff)) continue;
+		if (addr + size <= blitsync_lo[ch] || addr >= blitsync_hi[ch]) continue;
+		if (!blitsync_desc && blitsync_stride[ch] > blitsync_rowbytes && addr >= blitsync_first[ch]) {
+			long off = (long)addr - (long)blitsync_first[ch];
+			long inrow = off % blitsync_stride[ch];
+			if (inrow >= blitsync_rowbytes && inrow + size <= blitsync_stride[ch]) continue;
+		}
+		uaecptr pc = M68K_GETPC;
+		uae_u32 key = (pc * 31u + blitsync_pc * 7u + ch * 2u + (write ? 1u : 0u));
+		uae_u32 h = (key ^ (key >> 13)) & 4095;
+		int live = blt_info.blit_main || blt_info.blit_finald || blt_info.blit_pending;
+		if (blitsync_seen[h] == key + 1) return;
+		blitsync_seen[h] = key + 1;
+		if (blitsync_lines++ < 20000) {
+			fprintf(blitsync_f, "frame=%d vpos=%d pc=%08x %s%d addr=%06x ch=%c blitpc=%08x con0=%04x size=%dx%d range=%06x-%06x live=%d irq=%d\n",
+				vsync_counter, vpos, pc, write ? "W" : "R", size, addr, "ABCD"[ch], blitsync_pc, blitsync_con0,
+				blitsync_size_h, blitsync_size_v, blitsync_lo[ch], blitsync_hi[ch], live, regs.intmask);
+			fflush(blitsync_f);
+		}
+		return;
+	}
+}
