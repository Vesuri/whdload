{
  "archives": [
    {
      "input": "Gunship.lha",
      "output": "GunshipEnhanced-{version}-{date}.lha",
      "replace": {
        "GunshipHD/Gunship.slave": "build:Gunship",
        "GunshipHD/ReadMe": "release/ReadMe",
        "GunshipHD/Install": "release/Install"
      },
      "add": {
        "GunshipHD/GunshipNTSC.slave": "build:GunshipNTSC"
      },
      "remove": [],
      "source": {"dir": "GunshipHD/source", "variants": ["Gunship", "GunshipNTSC"]}
    }
  ]
}
