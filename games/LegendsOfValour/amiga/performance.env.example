# Copy to performance.env to select the rebuilt release slave on interactive boots.
# run.sh builds the normal slave in tmp/build-release; explicit SLAVE/WHD_ARGS win.
# Release builds always enable W1–W6; 63 retains the legacy selection and triggers a build.
# Mouse precision is also automatic. Optional timing: add 64 (use 127).
# Explicit SLAVE plus WHD_ARGS=CUSTOM2=0 also runs the release with optional timing off.
LOV_PERFORMANCE_BITS=63
