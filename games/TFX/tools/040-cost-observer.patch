+
+#include <map>
+#include <tuple>
+#include <cstdio>
+struct TfxStat { unsigned long long n=0, fetch=0, body=0, special=0, pad=0, reads=0, writes=0, rb=0, wb=0, chipr=0, chipw=0, chiprb=0, chipwb=0; };
+static bool tfx_on=false;
+static uae_u32 tfx_pc=0,tfx_base=0,tfx_frame=0;
+static unsigned long long tfx_begin=0;
+static std::map<uae_u32,TfxStat> tfx_stats;
+static std::map<std::pair<uae_u32,uae_u32>,unsigned long long> tfx_calls;
+static std::map<std::tuple<unsigned,unsigned,unsigned,unsigned>,unsigned long long> tfx_exceptions;
+static std::map<std::pair<unsigned,unsigned>,unsigned long long> tfx_cache;
+void tfx_start(unsigned base) { tfx_stats.clear();tfx_calls.clear();tfx_exceptions.clear();tfx_cache.clear();tfx_base=base;tfx_frame=0;tfx_begin=get_cycles();tfx_on=true; }
+static void tfx_mem(uae_u32 addr,unsigned bytes,bool wr) {
+ if(!tfx_on)return; auto &s=tfx_stats[tfx_pc];
+ if(wr){s.writes++;s.wb+=bytes;if(addr<0x200000){s.chipw++;s.chipwb+=bytes;}}
+ else{s.reads++;s.rb+=bytes;if(addr<0x200000){s.chipr++;s.chiprb+=bytes;}}
+}
+void tfx_save(const char *path) {
+ tfx_on=false; FILE*f=fopen(path,"w");if(!f)return;
+ fprintf(f,"meta,%llu,%llu,%u,%d,%d\n",tfx_begin,(unsigned long long)get_cycles(),tfx_frame,cpucycleunit,currprefs.fpu_no_unimplemented);
+ for(auto &v:tfx_stats){auto&s=v.second;fprintf(f,"pc,%u,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu\n",v.first,s.n,s.fetch,s.body,s.special,s.pad,s.reads,s.writes,s.rb,s.wb,s.chipr,s.chipw,s.chiprb,s.chipwb);}
+ for(auto &v:tfx_calls)fprintf(f,"call,%u,%u,%llu\n",v.first.first,v.first.second,v.second);
+ for(auto &v:tfx_exceptions)fprintf(f,"exception,%u,%u,%u,%u,%llu\n",std::get<0>(v.first),std::get<1>(v.first),std::get<2>(v.first),std::get<3>(v.first),v.second);
+ for(auto &v:tfx_cache)fprintf(f,"cache,%u,%u,%llu\n",v.first.first,v.first.second,v.second);
+ fclose(f);
+}
